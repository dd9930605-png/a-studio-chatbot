# OpenAI（方案 B 對話）
# 到 https://platform.openai.com/api-keys 建立金鑰後貼到 Vercel 環境變數
OPENAI_API_KEY=sk-xxxxxxxx

# 選用，預設 gpt-4o-mini（較便宜）
OPENAI_MODEL=gpt-4o-mini

# 後台清除資料密碼（預設 777；建議在 Vercel 也設定相同值）
ADMIN_SECRET=777

# 問卷導向模式（SurveyCake Plan B 演示）
# external = 推薦結果後導向 SurveyCake（此演示分支預設）
# internal = 導向站內 /survey（原本流程；設此值可暫時切回）
NEXT_PUBLIC_SURVEY_MODE=external

# 後測 SurveyCake 網址（可覆寫 conditions.json 的 surveyUrl）
NEXT_PUBLIC_SURVEYCAKE_URL=https://www.surveycake.com/s/Qy2B7
